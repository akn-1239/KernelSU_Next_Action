CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/OnePlus-9R/kernel_oneplus_sm8250-9R
KERNEL_SOURCE_BRANCH=eleven
KERNEL_CONFIG=vendor/kona-perf_defconfig
ARCH=arm64
KERNEL_FILE=Image
DISABLE-LTO=true
ENABLE_KERNELSU=true
APPLY_KSU_PATCH=true
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
ENABLE_SUSFS=true
SUSFS_SOURCE_BRANCH=kernel-4.19
APPLY_SUSFS_PATCH=true
USE_LOCAL_SUSFS_PATCH=false
ADD_SUSFS_CONFIG=false
DISABLE_CC_WERROR=true
