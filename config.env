CONFIG_ENV=config.env
KERNEL_SOURCE=https://github.com/OnePlusOSS/android_kernel_oneplus_sm8250
KERNEL_SOURCE_BRANCH=oneplus/sm8250_u_14.0.0_op9r
KERNEL_CONFIG=vendor/kona-perf_defconfig
ARCH=arm64
KERNEL_FILE=Image
DISABLE_LTO=true
ENABLE_KERNELSU=true
ENABLE_SUSFS=false
SUSFS_SOURCE_BRANCH=kernel-4.19
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
ADD_SUSFS_CONFIG=true
DISABLE_CC_WERROR=true
MAKE_BOOT_IMAGE=false
BOOTIMG_URL=https://github.com/akn-1239/KernelSU_Next_Action/releases/download/0.02/boot.1.img
